# ── Python 依赖与缓存 ──
# .pylibs / .pptx_lib 是脚本运行时就地安装的第三方库（python-pptx、lxml、Pillow 等），
# 数千个文件且可随时重装，不入库
.pylibs/
.pptx_lib/
__pycache__/
*.py[cod]

# ── Office 临时锁文件 ──
# Word/PPT 打开文档时生成，关闭后残留，非交付物
~$*

# ── 生成脚本的探针输出 ──
# 落盘核对用的临时文本，每次核对重新生成
docs/probe_*.txt

# ── 编辑器与系统 ──
.vscode/
.idea/
Thumbs.db
Desktop.ini

# ── Flutter / Dart ──
# 构建产物与工具缓存，均可由 pubspec.yaml 重新生成，不入库
.dart_tool/
build/
.flutter-plugins-dependencies
*.iml
# pubspec.lock：应用（非 library）应当入库以锁定依赖版本，故不忽略

# ── Android 构建 ──
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
# .kotlin/ 是 in-process 编译策略（见 gradle.properties）产生的会话缓存，
# 每次构建重新生成
android/.kotlin/

# ── 签名密钥（绝不入库）──
# 正式签名证书泄露等于应用可被伪造，且证书一旦启用不可更换（上架前置手册 P7）
*.jks
*.keystore
android/key.properties

# ── iOS ──
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/flutter_export_environment.sh

# ── Windows 构建 ──
windows/flutter/ephemeral/

# ── 部署与密钥（绝不入库）──
# 各环境真实密钥文件。三套环境的密钥全部落在 deploy/env/ 下，
# 命名为 .env.dev / .env.staging / .env.prod。
# 先用 .env* 通配全部忽略，再用 ! 显式放行 *.example 模板 ——
# 顺序不可颠倒：gitignore 是后规则覆盖前规则，反了会把模板一起忽略掉，
# 新同事 clone 后就没有任何可参照的变量清单。
deploy/env/.env*
!deploy/env/.env*.example
# 兼容历史路径（早期方案把 .env 放在 deploy/ 根下）
.env
# env-up.sh 的当前环境记账文件，属机器本地状态
deploy/.current-env
# 本地备份文件
/var/backups/
/swapfile

# ── Java / Maven（后端工程，条目[121] U-1）──
# Maven 构建输出与字节码，均可由 pom.xml 重新生成，不入库
target/
*.class
# 打包产物：正式出包走 deploy 流水线，不经仓库
*.jar
*.war
# JVM 崩溃日志，排障一次性产物
hs_err_pid*.log
replay_pid*.log
