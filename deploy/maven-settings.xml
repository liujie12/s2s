<?xml version="1.0" encoding="UTF-8"?>
<!--
  S2S Maven 构建期镜像源配置（仅构建阶段使用，不进运行镜像）
  ----------------------------------------------------------------------------
  用途：Dockerfile 的 builder 阶段把它复制到 /root/.m2/settings.xml，
        使 mvn 从阿里云 public 仓库而非 Maven Central 拉依赖。

  为什么需要：
    2026-10-06 首次部署实测，服务器直连 Maven Central 执行
    `mvn dependency:go-offline` 超过 13 分钟仍未完成（国内网络到
    repo.maven.apache.org 带宽受限）。改用阿里云镜像后预计 1-3 分钟。

  影响面：
    · 仅构建期生效，settings.xml 不出现在运行镜像中；
    · 只镜像 central（<mirrorOf>central</mirrorOf>），不劫持其他仓库
      （如 Spring 的 milestone 仓库），避免改变依赖解析结果。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Public Repository</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

</settings>
