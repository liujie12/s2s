# ============================================================================
# S2S 开发环境环境变量模板
# ----------------------------------------------------------------------------
# 用途：本地开发联调，连接本地 MySQL/Redis，使用本地测试密钥。
# 使用方式（项目根目录下执行）：
#   cp deploy/env/.env.dev.example deploy/env/.env.dev
#   chmod 600 deploy/env/.env.dev
#   编辑 .env.dev 填入真实值
#
# 纪律：
#   1. .env.dev 不入 git，仓库只提交 .env.dev.example。
#      见 .gitignore 中 deploy/env/.env* 的覆盖规则
#   2. dev 环境密钥可以使用弱口令或统一口令以降低心智负担，
#      但【禁止】留空 —— 留空导致 Redis 无口令运行，连接代码路径与 prod 不一致
#   3. 启动时若缺少必需变量，env-up.sh 会快速失败
# ============================================================================

# -- 站点基础配置 ---------------------------------------------------------------
# dev 环境通常使用 localhost 或 127.0.0.1
SITE_DOMAIN=localhost
# ACME 注册邮箱（dev 不实际申请证书，但 Caddyfile 引用了此变量，不能为空）
ACME_EMAIL=dev@localhost

# -- 应用版本 -------------------------------------------------------------------
APP_VERSION=latest

# -- MySQL 配置 -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=dev_root_password
MYSQL_DATABASE=s2s_dev
MYSQL_USER=s2s
MYSQL_PASSWORD=dev_mysql_password
MYSQL_TRACK_DATABASE=s2s_track_dev

# 数据面 TLS 的服务端身份校验（2026-10-10 按说明文档 §2.9 DEC-05 收紧）
# dev 与 staging/prod 同口径（不放宽）——「本地只加密不校验」正是最典型的配置漂移，
# 与 dev 仍保留 Redis requirepass 的理由相同（见 docker-compose.dev.yml 头部）。
# 本地首次拉起后需跑一次：bash deploy/scripts/build-mysql-ca-truststore.sh dev
# 【回滚】改成 MYSQL_SSL_MODE=REQUIRED（只加密不校验）后重启 app 即可。
MYSQL_SSL_MODE=VERIFY_CA
# 只允许字母与数字（会拼进 JDBC URL 查询串）
# 生成建议：openssl rand -base64 18 | tr -d '/+=' | cut -c1-24
MYSQL_TLS_TRUSTSTORE_PASSWORD=dev_truststore_password

# -- Redis 配置 -----------------------------------------------------------------
# dev 也必须设置口令，见 docker-compose.dev.yml 头部「不放宽的一项」
REDIS_PASSWORD=dev_redis_password

# -- 密钥与凭证 -------------------------------------------------------------------
# 字段名必须是 version（整数，对应 DB 的 key_version TINYINT 列），不是 id/字符串；
# key 须解出恰好 32 字节：hex 用 64 位、base64 用 44 位。写法见 CryptoConfig。requireVersion。
AEAD_MASTER_KEYS_JSON=[{"version":1,"key":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]
HMAC_PEPPERS_JSON=[{"version":1,"key":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]
JWT_SECRET=cccccccccccccccccccccccccccccccc

# -- OSS 配置（dev 可使用假的 Bucket 名称，代码中应判断环境并跳过 OSS 上传）-----
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=dev_oss_key_id
OSS_ACCESS_KEY_SECRET=dev_oss_key_secret
OSS_BUCKET_NAME=s2s-media-dev

# -- 大模型 API Key（通义千问 / 阿里云百炼；B2-4 阶段①）-------------------------
# 变量名取官方口径 DASHSCOPE_API_KEY（application.yml 的 s2s.ai.api-key 消费）。
# 留空 = 走 dry-run 纯规则桩（不调模型、不产生费用）—— dev 默认即此，无需填。
# 填真值并置 s2s.ai.dry-run=false 才走真实通道；Key 与地域绑定，须与 s2s.ai.endpoint 同地域。
DASHSCOPE_API_KEY=

# -- S1 双向推送（B2-2 阶段 2：厂商真实通道）-------------------------------------
# 服务端密钥，禁入库（本模板只放变量名）。enabled=true 且凭据为空时应用启动即失败。
# 未启用 = 对应 Sender 不注册，下发走站内通知兜底。
HUAWEI_PUSH_ENABLED=false
HUAWEI_PUSH_APP_ID=
HUAWEI_PUSH_APP_SECRET=
# 🟡 2026-10-21：小米 AppID/AppKey/AppSecret 已取得；应用未在小米商店上架（官方硬性要求）⇒ 暂不开启。
# 客户端 AppId/AppKey 写 android/local.properties（不入库），不走本文件。
XIAOMI_PUSH_ENABLED=false
XIAOMI_PUSH_APP_SECRET=
XIAOMI_PUSH_PACKAGE_NAME=com.s2s.zhaoyazhao.dev
# 私信消息 template/channel（小米运营平台申请；未配置时按普通通道下发）
XIAOMI_PUSH_CHANNEL_ID=
XIAOMI_PUSH_TEMPLATE_ID=
XIAOMI_PUSH_TEMPLATE_PARAM=

# -- 可选配置（dev 可留空）------------------------------------------------------
# 微信开放平台移动应用凭据（B2-6a 微信登录）。资质审批中，留空 = 微信登录 fail-closed（50001）。
# 仅服务端使用；AppSecret 禁入库、禁写日志、禁回传客户端。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SLS_ENDPOINT=
SLS_ACCESS_KEY_ID=
SLS_ACCESS_KEY_SECRET=
SLS_PROJECT=
SLS_LOGSTORE=
