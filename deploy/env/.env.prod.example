# ============================================================================
# S2S 生产环境环境变量模板
# ----------------------------------------------------------------------------
# 用途：生产环境的密钥与配置，由运维人员手动创建，严格保密。
# 使用方式：
#   cp deploy/env/.env.prod.example deploy/env/.env.prod
#   chmod 600 deploy/env/.env.prod
#   编辑 .env.prod 填入真实值
#
# 纪律（《系统安全设计方案》§4.4/G3 裁定）：
#   1. .env.prod 不入 git，仓库只提交 .env.prod.example
#   2. 镜像内不 COPY .env，仅通过 docker-compose env_file 注入
#   3. 启动时校验必需环境变量存在，缺失即快速失败
#   4. AEAD 密钥必须 32 字节（AES-256-GCM），HMAC pepper 必须 32 字节
#   5. 生产密钥生成命令示例：
#      openssl rand -base64 32   # AEAD 密钥
#      openssl rand -base64 32   # HMAC pepper
#      openssl rand -hex 32      # JWT 密钥
# ============================================================================

# -- 站点基础配置 ---------------------------------------------------------------
# 域名（用于 Caddy TLS 证书申请与反向代理）
SITE_DOMAIN=s2s.build110.com
# ACME 注册邮箱（用于 Let's Encrypt 证书到期提醒）
ACME_EMAIL=admin@example.com

# -- 应用版本 -------------------------------------------------------------------
# 必须等于「当前线上镜像 tag」：base compose 用它定位镜像，且为必填（缺失直接报错）。
# deploy-manual.sh 每次发版成功后会自动写回实际 tag；请勿改成不存在的值 ——
# 否则手工 docker compose run/up 会因镜像缺失而静默走 build 分支重建旧产物。
APP_VERSION=1.0.0

# -- MySQL 配置 -----------------------------------------------------------------
# Root 口令（仅用于初始化，应用不直接使用 root 连接）
MYSQL_ROOT_PASSWORD=change_me_prod_root_password
# 业务数据库名与凭据
MYSQL_DATABASE=s2s
MYSQL_USER=s2s
MYSQL_PASSWORD=change_me_prod_mysql_password
# 埋点独立数据库名（《可观测性架构方案》§4.4）
MYSQL_TRACK_DATABASE=s2s_track

# 数据面 TLS 的服务端身份校验（2026-10-10 按说明文档 §2.9 DEC-05 收紧）
# VERIFY_CA = 在「强制加密」基础上再校验 MySQL 服务端证书链；
# 信任库文件由 deploy/scripts/build-mysql-ca-truststore.sh 生成，
# 经 compose 只读挂载到 app 的 /opt/s2s/certs/mysql-ca.p12。
# 【回滚】改成 MYSQL_SSL_MODE=REQUIRED（只加密不校验）后重启 app 即可。
MYSQL_SSL_MODE=VERIFY_CA
# 信任库口令：只允许字母与数字（会拼进 JDBC URL 查询串），与生成时保持一致。
# 里面装的是 MySQL 自签 CA 的公开证书，口令只用于 keystore 完整性校验、非机密；
# 生成建议：openssl rand -base64 18 | tr -d '/+=' | cut -c1-24
MYSQL_TLS_TRUSTSTORE_PASSWORD=change_me_prod_truststore_password

# -- Redis 配置 -----------------------------------------------------------------
# 口令设为空值则 Redis 容器健康检查失败，应用启动时抛出异常
REDIS_PASSWORD=change_me_prod_redis_password

# -- 密钥与凭证（《部署架构设计文档》§7.1 密钥分类表）-------------------------------
# 1. 加密列主密钥（AEAD）—— 用于 user.phone / user.real_name_enc 等列加密/解密
#    JSON 格式，支持多密钥轮换。字段名必须是 version（整数，对应 DB 的 key_version
#    TINYINT 列），不是 id/字符串；key 须解出恰好 32 字节（hex 64 位 / base64 44 位）。
#    示例：[{"version":1,"key":"your-32byte-aes-key=="}]
AEAD_MASTER_KEYS_JSON=[{"version":1,"key":"change_me_prod_aead_key_32_bytes=="}]

# 2. HMAC pepper —— 盲索引生成。保管强度须高于 AEAD，泄露需停写+全量重算
#    JSON 格式，字段名与长度要求同 AEAD。示例：[{"version":1,"key":"your-32byte-hmac-key=="}]
HMAC_PEPPERS_JSON=[{"version":1,"key":"change_me_prod_hmac_pepper_32_bytes=="}]

# 3. JWT 签名密钥 —— 登录态签发与校验
JWT_SECRET=change_me_prod_jwt_secret_key_32_bytes

# 4. OSS 子账号凭证 —— 仅限该桶、仅限上传，不用主账号 AccessKey
#    配以下三个变量，权限由 RAM 策略控制
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=change_me_prod_oss_key_id
OSS_ACCESS_KEY_SECRET=change_me_prod_oss_key_secret
OSS_BUCKET_NAME=s2s-media

# 4.1 实名核验（阿里云信息核验 Id2MetaVerify）
#     dry-run=true 时不调外部（仅身份证末 4 位 0000 通过）；
#     改 false 后必须配 AK，缺失会在启动期快速失败；密钥只落本文件，禁止入库/入日志
CERT_PROVIDER_DRY_RUN=true
CLOUDAUTH_ENDPOINT=https://cloudauth.cn-beijing.aliyuncs.com
CLOUDAUTH_ACCESS_KEY_ID=change_me_prod_cloudauth_key_id
CLOUDAUTH_ACCESS_KEY_SECRET=change_me_prod_cloudauth_key_secret

# 5. 大模型 API Key —— 通义千问 / 阿里云百炼（B2-4 阶段①，Batch2 使用）
#    变量名取官方口径 DASHSCOPE_API_KEY（application.yml 的 s2s.ai.api-key 消费）。
#    取 Key：https://bailian.console.aliyun.com/ 右上角先选地域（华北2·北京）再创建；
#    官方明确「各地域有独立域名/Key/模型列表，不能跨地域混用」，须与 s2s.ai.endpoint 同地域。
#    ⚠ 该变量在【容器创建时】注入：改完须重建容器（compose up -d --no-deps app），docker restart 不生效。
#    ⚠ 仅服务端使用（官方禁在客户端代码中使用长期 Key）；置 s2s.ai.dry-run=false 才真正调用。
DASHSCOPE_API_KEY=change_me_prod_dashscope_api_key

# -- S1 双向推送（B2-2 阶段 2：厂商真实通道）-------------------------------------
# 服务端密钥，禁入库、禁入镜像；仅在 ECS 的 deploy/env/.env.prod 填真值。
# enabled=true 且凭据为空时应用启动即失败（不给静默降级留口子）；未启用则下发走站内兜底。
# ⚠ 环境变量在【容器创建时】注入：改完须重建 app 容器（docker compose up -d --no-deps app）。
HUAWEI_PUSH_ENABLED=false
HUAWEI_PUSH_APP_ID=
HUAWEI_PUSH_APP_SECRET=
# 🟡 2026-10-21：小米 AppID/AppKey/AppSecret 已取得；应用未在小米商店上架（官方硬性要求）⇒ 暂不开启。
# 客户端 AppId/AppKey 写 android/local.properties（不入库），不走本文件。
# 上架后：此处填 AppSecret 并改 true → docker compose up -d --no-deps app（改环境变量须重建容器）。
XIAOMI_PUSH_ENABLED=false
XIAOMI_PUSH_APP_SECRET=
XIAOMI_PUSH_PACKAGE_NAME=com.s2s.zhaoyazhao.dev
# 私信消息 template/channel（小米运营平台申请；未配置时按普通通道下发）
XIAOMI_PUSH_CHANNEL_ID=
XIAOMI_PUSH_TEMPLATE_ID=
XIAOMI_PUSH_TEMPLATE_PARAM=

# -- 可选配置 -------------------------------------------------------------------
# 微信开放平台移动应用凭据（B2-6a 微信登录）。资质审批中，未到位前留空 =
# 微信登录 fail-closed（50001，不发起微信请求）；取得 AppID/AppSecret 后填入并重建 app 容器。
# AppSecret 仅存服务端，禁入库、禁写日志、禁回传客户端。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 阿里云 SLS 配置（迁移目标，阈值命中后启用，见《可观测性架构方案》§9）
SLS_ENDPOINT=
SLS_ACCESS_KEY_ID=
SLS_ACCESS_KEY_SECRET=
SLS_PROJECT=
SLS_LOGSTORE=
