# ============================================================================
# S2S 预发布环境环境变量模板
# ----------------------------------------------------------------------------
# 用途：staging 环境的密钥与配置，与生产环境使用相同的密钥体系但不同的值。
#       staging 的数据库实例与 prod 物理隔离，但 DDL 结构一致。
# 使用方式：
#   cp deploy/env/.env.staging.example deploy/env/.env.staging
#   chmod 600 deploy/env/.env.staging
#   编辑 .env.staging 填入真实值
#
# 纪律：
#   1. .env.staging 不入 git
#   2. staging 的密钥强度要求与 prod 一致（AEAD 密钥 32 字节、HMAC 32 字节等）
#      但使用不同的值，防止密钥泄露时 prod 被连带影响
#   3. staging 与 prod 使用不同的数据库实例，数据完全隔离
# ============================================================================

# -- 站点基础配置 ---------------------------------------------------------------
SITE_DOMAIN=staging.example.com
ACME_EMAIL=admin@example.com

# -- 应用版本 -------------------------------------------------------------------
APP_VERSION=1.0.0

# -- MySQL 配置 -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_staging_root_password
MYSQL_DATABASE=s2s
MYSQL_USER=s2s
MYSQL_PASSWORD=change_me_staging_mysql_password
MYSQL_TRACK_DATABASE=s2s_track

# 数据面 TLS 的服务端身份校验（2026-10-10 按说明文档 §2.9 DEC-05 收紧）
# 口径说明与回滚方式见 .env.prod.example 同处注释
# 【回滚】改成 MYSQL_SSL_MODE=REQUIRED（只加密不校验）后重启 app 即可。
MYSQL_SSL_MODE=VERIFY_CA
# 只允许字母与数字（会拼进 JDBC URL 查询串）
# 生成建议：openssl rand -base64 18 | tr -d '/+=' | cut -c1-24
MYSQL_TLS_TRUSTSTORE_PASSWORD=change_me_staging_truststore_password

# -- Redis 配置 -----------------------------------------------------------------
REDIS_PASSWORD=change_me_staging_redis_password

# -- 密钥与凭证 -------------------------------------------------------------------
# 字段名必须是 version（整数，对应 DB 的 key_version TINYINT 列），不是 id/字符串；
# key 须解出恰好 32 字节：hex 用 64 位、base64 用 44 位。写法见 CryptoConfig。requireVersion。
AEAD_MASTER_KEYS_JSON=[{"version":1,"key":"change_me_staging_aead_key_32_bytes=="}]
HMAC_PEPPERS_JSON=[{"version":1,"key":"change_me_staging_hmac_pepper_32_bytes=="}]
JWT_SECRET=change_me_staging_jwt_secret_key_32

# -- OSS 配置 -------------------------------------------------------------------
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=change_me_staging_oss_key_id
OSS_ACCESS_KEY_SECRET=change_me_staging_oss_key_secret
OSS_BUCKET_NAME=s2s-media-staging

# -- 大模型 API Key（通义千问 / 阿里云百炼；B2-4 阶段①）-------------------------
# 变量名取官方口径 DASHSCOPE_API_KEY（application.yml 的 s2s.ai.api-key 消费）。
# 留空 = 走 dry-run 纯规则桩；填真值（勿入仓库）并置 s2s.ai.dry-run=false 才走真实通道。
# Key 与地域绑定，须与 s2s.ai.endpoint 同地域（跨地域调用会 401 invalid_api_key）。
DASHSCOPE_API_KEY=change_me_staging_dashscope_api_key

# -- S1 双向推送（B2-2 阶段 2：厂商真实通道）-------------------------------------
# 服务端密钥，禁入库。enabled=true 且凭据为空时应用启动即失败；未启用则下发走站内兜底。
HUAWEI_PUSH_ENABLED=false
HUAWEI_PUSH_APP_ID=
HUAWEI_PUSH_APP_SECRET=
# 🟡 2026-10-21：小米 AppID/AppKey/AppSecret 已取得；应用未在小米商店上架（官方硬性要求）⇒ 暂不开启。
# 客户端 AppId/AppKey 写 android/local.properties（不入库），不走本文件。
XIAOMI_PUSH_ENABLED=false
XIAOMI_PUSH_APP_SECRET=
XIAOMI_PUSH_PACKAGE_NAME=com.s2s.zhaoyazhao.dev
# 私信消息 template/channel（小米运营平台申请；未配置时按普通通道下发）
XIAOMI_PUSH_CHANNEL_ID=
XIAOMI_PUSH_TEMPLATE_ID=
XIAOMI_PUSH_TEMPLATE_PARAM=

# -- 可选配置 -------------------------------------------------------------------
# 微信开放平台移动应用凭据（B2-6a 微信登录）。资质审批中，未到位前留空 =
# 微信登录 fail-closed（50001，不发起微信请求）；取得 AppID/AppSecret 后填入并重建 app 容器。
# AppSecret 仅存服务端，禁入库、禁写日志、禁回传客户端。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SLS_ENDPOINT=
SLS_ACCESS_KEY_ID=
SLS_ACCESS_KEY_SECRET=
SLS_PROJECT=
SLS_LOGSTORE=
