# ============================================================================
# S2S MySQL 8.4 LTS 自定义配置
# ----------------------------------------------------------------------------
# 依据：《部署架构设计文档》§3.1 内存预算表、§4.2 硬性配置①
#       《可观测性架构方案》§7（盘分配表、binlog 过期）
#
# 硬性纪律：
#   1. innodb_buffer_pool_size = 256M（与 450MB 内存预算对应）
#   2. binlog_expire_logs_seconds = 259200（3 天，必须设置，否则 binlog 无声吃满盘）
#      注意：MySQL 8.4 已【移除】旧参数 expire_logs_days，写它会导致
#            unknown variable 并使 mysqld 启动失败（已实测确认）
#   3. 禁止使用默认值，每项参数都标注了配置理由
#
# 文件权限要求（否则本文件被静默忽略，全部配置失效）：
#   mysqld 会拒绝加载 world-writable（如 777）的配置文件，且仅在日志里打一行
#   「World-writable config file is ignored」，表面看容器正常启动但配置全丢。
#   部署时必须执行：chmod 644 deploy/config/my.cnf
#
# 语法校验命令（改动本文件后必须执行）：
#   docker run --rm -v $(pwd)/deploy/config/my.cnf:/etc/my_test.cnf:ro \
#     -e MYSQL_ALLOW_EMPTY_PASSWORD=1 mysql:8.4 \
#     mysqld --defaults-file=/etc/my_test.cnf --validate-config
# ============================================================================

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]

# -- 字符集 ---------------------------------------------------------------------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# -- 时区 -----------------------------------------------------------------------
default-time-zone = +08:00

# -- InnoDB 配置（内存预算关键参数）-----------------------------------------------
# 内存预算 450MB 中，InnoDB Buffer Pool 占 256MB
# 内测期数据量小，256MB 绰绰有余，数据增长后应优先关注此参数
innodb_buffer_pool_size = 256M

# 日志文件大小，保持较小以节省磁盘（与 3GB binlog 预算一致）
innodb_log_file_size = 256M
innodb_log_buffer_size = 16M

# 数据刷新行为（内测期可接受偏保守的配置）
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT

# -- binlog 配置（硬性配置①：必须设置过期时间）----------------------------------
# 盘分配中 binlog 预算仅 3GB，不设过期会无声吃满盘
# 磁盘满 → MySQL 拒写 → 全站不可用（《可观测性架构方案》§7）
#
# 注意：MySQL 8.4 已移除 expire_logs_days，必须使用 binlog_expire_logs_seconds
#       binlog_format 已【不再显式配置】：8.4 中该参数 deprecated（实测产生
#       [MY-011070] warning），且默认值本就是 ROW，写它只增加告警噪声。
server-id = 1
log-bin = mysql-bin
binlog_expire_logs_seconds = 259200
max_binlog_size = 256M

# -- 连接与线程 ----------------------------------------------------------------
# 2 核机器，保持较小连接数
max_connections = 50
thread_cache_size = 8

# -- 临时表与排序 --------------------------------------------------------------
tmp_table_size = 16M
max_heap_table_size = 16M
sort_buffer_size = 512K
join_buffer_size = 512K

# -- 查询缓存 -------------------------------------------------------------------
# MySQL 8.4 已移除查询缓存，显式关闭
# 应用层查询缓存由 Caffeine + Redis 两层承载（R3）

# -- 慢查询日志（用于可观测性阈值 T3 的根因定位）-------------------------------
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow-query.log
long_query_time = 2
log_queries_not_using_indexes = 0

# -- 安全配置 -------------------------------------------------------------------
# 本地 root 连接不设密码（仅限容器内 socket 连接）
# 远程连接必须通过强口令认证
skip_name_resolve

# -- 每表独立表空间 -------------------------------------------------------------
# 便于备份恢复时单独处理大表
innodb_file_per_table = 1