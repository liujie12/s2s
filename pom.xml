<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      版本托管定案（技术栈 §3）：依赖版本由 spring-boot-starter-parent 托管，业务 pom 禁动态版本号与版本范围。
      OQ-1 裁量记录：选 3.5.16 —— Spring Boot 3.x 最后一代特性线（3.5.x）的最新补丁版，发布于 2026-06-25，
      官方公告为 3.5.x 世代最后一个 OSS 版本，收齐该线全部修复，适合作为 Batch1 钉版基线；
      4.x 属大版本跃迁，超出条目[121]「Spring Boot 3」定案范围，不选。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.s2s</groupId>
    <artifactId>s2s-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>s2s-server</name>
    <description>找鸭找（s2s）后端单体服务：Java 21 + Spring Boot 3 + MyBatis-Plus（详设 §1；技术栈 §3）</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
          KTD-2 定案：持久层用 MyBatis-Plus 3.5.x，不用 JPA（本 pom 禁止出现 spring-boot-starter-data-jpa / hibernate）。
          显式钉版 3.5.17（2026-07-09，Maven Central 最新）：其 boot3 starter 传递 mybatis-spring 3.0.5，
          与 Spring Boot 3.5（Spring Framework 6.2）兼容；mybatis-spring 4.x 仅出现在 boot4 starter，与本工程无关。
        -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
    </properties>

    <dependencies>
        <!-- Web MVC：详设 §3.1 横切链（Filter/Interceptor）与 controller 的承载层 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation：详设 §5.3/§5.4 输入校验（契约字段约束的唯一执行层） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Redis：会话/Token/幂等键/限频计数的载体（详设 §3.3/§3.4；技术栈 §6） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          actuator：compose healthcheck 与 caddy depends_on: service_healthy 依赖 /actuator/health
          （部署架构设计文档）；jar 内默认仅暴露 health 端点，见 application.yml 的
          management.endpoints.web.exposure.include: health（收敛暴露面，安全 §10）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- MyBatis-Plus：KTD-2 定案持久层；简单 CRUD 用之，性能语句走 XML + EXPLAIN（详设 §7） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 8.4 驱动（技术栈 §5）；版本由 parent 托管 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Flyway：schema 唯一管理者（编码规范 §4.9）；双库迁移目录 db/migration{,_track} 由 U-4 落地。
          注意：Flyway 在 classpath 且无可达数据库时应用启动会失败——U-1 不要求应用可启动（数据源在 U-5 配置）。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 测试底座（版本由 parent 托管；U-3 起承载 ErrorCodeTest 等单测） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              技术栈 §3：Java 21，以 release 编译保证 API 面一致。
              KTD-3：Java 21 不开虚拟线程（退出条件：Java 24 或压测证明 I/O 阻塞），
              本工程不配置任何虚拟线程开关（Spring Boot 默认即关闭）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <!-- 可执行 jar 打包与 deploy/Dockerfile 的 java -jar 运行方式对齐（部署架构设计文档） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
