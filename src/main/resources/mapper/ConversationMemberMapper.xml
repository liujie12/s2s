<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.s2s.server.chat.mapper.ConversationMemberMapper">

    <!--
      成员行读取（成员校验与已读水位，KTD1）。

      EXPLAIN 结论：WHERE conversation_id = ? AND user_id = ? 命中复合主键 PRIMARY，
      type=const，Extra 为空（覆盖索引回表一次即出整行）。

      为什么不用 BaseMapper：复合主键只标了 conversation_id，selectById 只能按半键查，
      会取到另一位成员的行。
    -->
    <select id="selectMember" resultType="com.s2s.server.chat.entity.ConversationMemberEntity">
        SELECT conversation_id,
               user_id,
               last_read_seq,
               pushed_unread,
               created_at,
               updated_at
        FROM conversation_member
        WHERE conversation_id = #{conversationId}
          AND user_id = #{userId}
    </select>

    <!--
      对方已读水位（R17 已读回执）。

      会话恒为两名成员，`user_id <> #{userId}` 只剩另一行；LIMIT 1 是防御性写法，
      防止历史脏数据（同会话出现第三条成员行）把结果集放大。

      EXPLAIN 结论：WHERE conversation_id = ? 命中复合主键前缀，type=ref；
      过滤 user_id 后至多两行，代价可忽略（仅在打开会话时执行一次）。
    -->
    <select id="selectPeerLastReadSeq" resultType="java.lang.Integer">
        SELECT last_read_seq
        FROM conversation_member
        WHERE conversation_id = #{conversationId}
          AND user_id &lt;&gt; #{userId}
        LIMIT 1
    </select>

    <!--
      推进已读水位并复位已推送标记（R10 / KTD7）。

      GREATEST 保证已读只增不减：重复提交或乱序提交（先点开旧页、再点开新页）都不会把
      水位往回拨，符合「已读状态单向推进」的成功标准。

      pushed_unread 复位后，下一轮未读可以再推首条（KTD7：不依赖 Redis TTL）。

      EXPLAIN 结论：UPDATE 按复合主键等值命中，锁单行；EXPLAIN 对 UPDATE 走 PRIMARY const。
    -->
    <update id="markRead">
        UPDATE conversation_member
        SET last_read_seq = GREATEST(last_read_seq, #{lastReadSeq}),
            pushed_unread = 0
        WHERE conversation_id = #{conversationId}
          AND user_id = #{userId}
    </update>

    <!--
      抢占未读期间首条推送标记（R14 / KTD7）。

      条件 update 是原子操作：并发两条新消息只有一个能把 pushed_unread 从 0 改成 1，
      避免同一会话在未读期间推两条。读会话时 markRead 复位该列，下一轮未读可再推。

      EXPLAIN 结论：UPDATE 按复合主键等值命中，锁单行。
    -->
    <update id="markPushed">
        UPDATE conversation_member
        SET pushed_unread = 1
        WHERE conversation_id = #{conversationId}
          AND user_id = #{userId}
          AND pushed_unread = 0
    </update>

</mapper>
