<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.s2s.server.chat.mapper.MessageMapper">

    <!--
      未回复额度计数（R26）：对方最后一条文本之后、我方发出的文本条数。

      EXPLAIN 结论：外层与子查询都带 conversation_id 等值条件，命中
      idx_conversation_visible_seq(conversation_id, visible_to, seq) 的最左前缀；
      type='text' 与 sender_id 不在该索引中，作为回表过滤（Extra=Using where）。
      单会话消息量为百级，回表规模即会话内行数，可接受；不为它单开索引
      （与 U4 的分页索引高度重叠，只增写放大）。

      为什么只数 type = 'text'：申请卡与联系方式卡不计入未回复额度（R26 原文），
      若把卡片算进去，一次「申请 + 同意」就会占掉三条额度中的两条。

      COALESCE(..., 0)：对方从未发过文本时以 0 为下界，我方全部文本计入。
    -->
    <select id="countUnrepliedText" resultType="int">
        SELECT COUNT(*)
        FROM message
        WHERE conversation_id = #{conversationId}
          AND type = 'text'
          AND sender_id = #{senderId}
          AND seq > COALESCE((
              SELECT MAX(seq)
              FROM message
              WHERE conversation_id = #{conversationId}
                AND type = 'text'
                AND sender_id &lt;&gt; #{senderId}
          ), 0)
    </select>

    <!--
      翻历史（U4）：取 beforeSeq 之前的一页，倒序。

      可见性：联系方式卡只对 visible_to 指向的申请人可见（R22），非目标用户查不到该行；
      文本与申请卡 visible_to 为 NULL，双方都能看到。

      EXPLAIN 结论：conversation_id 等值命中 idx_conversation_visible_seq 最左前缀；
      `visible_to IS NULL OR visible_to = ?` 使第二列无法作为等值连续前缀，故退化为
      该索引上的 range + 回表过滤（Extra=Using index condition）；seq 条件在同一索引内
      继续收窄，排序沿索引第三列反向扫描，无 filesort。单会话消息量为百级，代价可接受。
    -->
    <select id="selectBefore" resultType="com.s2s.server.chat.entity.MessageEntity">
        SELECT id,
               conversation_id,
               seq,
               sender_id,
               type,
               content,
               visible_to,
               created_at
        FROM message
        WHERE conversation_id = #{conversationId}
          AND (visible_to IS NULL OR visible_to = #{userId})
        <if test="beforeSeq != null">
          AND seq &lt; #{beforeSeq}
        </if>
        ORDER BY seq DESC
        LIMIT #{limit}
    </select>

    <!--
      增量拉取（U4）：取 afterSeq 之后的一页，正序。索引与可见性口径同 selectBefore
      （EXPLAIN 结论同上：idx_conversation_visible_seq 前缀 + 回表过滤，沿索引正序扫描无 filesort）。
    -->
    <select id="selectAfter" resultType="com.s2s.server.chat.entity.MessageEntity">
        SELECT id,
               conversation_id,
               seq,
               sender_id,
               type,
               content,
               visible_to,
               created_at
        FROM message
        WHERE conversation_id = #{conversationId}
          AND (visible_to IS NULL OR visible_to = #{userId})
          AND seq &gt; #{afterSeq}
        ORDER BY seq ASC
        LIMIT #{limit}
    </select>

    <!--
      后台举报复核（U7）：取会话最近一页消息，不做 visible_to 过滤。

      EXPLAIN 结论：conversation_id 等值命中 uk_conversation_seq(conversation_id, seq)
      最左前缀，ORDER BY seq DESC 沿索引反向扫描无 filesort；LIMIT 由后台固定为
      ChatLimits.MESSAGE_PAGE_MAX_SIZE，不会无界拉取。
    -->
    <select id="selectRecentByConversation" resultType="com.s2s.server.chat.entity.MessageEntity">
        SELECT id,
               conversation_id,
               seq,
               sender_id,
               type,
               content,
               visible_to,
               created_at
        FROM message
        WHERE conversation_id = #{conversationId}
        ORDER BY seq DESC
        LIMIT #{limit}
    </select>

    <!--
      未读汇总（U5 / KTD9）：我的全部可见会话里，seq 超过已读水位、对我可见、且非我发送的消息数。

      「非我发送」：发送后我的水位仍在原地，若不排除，自己刚发的消息会把自己标成未读。
      「可见会话」：参与 JOIN 的 conversation 必须落在隐藏窗口内，列表看不到的会话不贡献角标。

      EXPLAIN 结论：驱动表 conversation_member 以 idx_user(user_id) 定位我的成员行（复合主键
      第二列无法单独等值）；conversation 走 PRIMARY 等值回表并过滤 last_message_at 下界；
      message 走 idx_conversation_visible_seq(conversation_id, visible_to, seq) 前缀回表，
      seq 条件在同一索引内收窄。单用户会话量级为百级，无排序无分页，代价可接受。
    -->
    <select id="countUnreadForUser" resultType="long">
        SELECT COUNT(*)
        FROM conversation_member cm
        JOIN conversation c
          ON c.id = cm.conversation_id
        JOIN message m
          ON m.conversation_id = c.id
        WHERE cm.user_id = #{userId}
          AND cm.deleted_at IS NULL
          AND c.last_message_at &gt;= #{visibleSince}
          AND m.seq &gt; cm.last_read_seq
          AND (m.visible_to IS NULL OR m.visible_to = #{userId})
          AND m.sender_id &lt;&gt; #{userId}
    </select>

</mapper>
