<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.s2s.server.contact.mapper.ContactPostMapper">

    <!--
      联系方式密文材料（详设 §5.5.1 第 [5][6] 步；安全 §3「唯一出口」）。

      EXPLAIN 结论：主键等值查询，执行计划唯一可预期 —— type=const、key=PRIMARY、
      rows=1。本查询含 `contact_value_enc`（VARBINARY 密文）列，必然回表取数，
      覆盖索引在此不适用；但这是单行主键读取，回表 1 行，不构成性能问题。
      （主键等值查询无需额外索引设计，故不附 explain 脚本；与 PostQueryMapper 的
      `selectDetailRow` 同形态。）

      列集合纪律：只出六列，禁 SELECT * —— `address`/`desc` 等列与本次解密无关，
      顺手带出即扩大敏感数据在进程内的暴露面。
    -->
    <select id="selectContactRow" resultType="map">
        SELECT p.id,
               p.user_id,
               p.contact_channel,
               p.contact_value_enc,
               p.key_version,
               p.status
        FROM post p
        WHERE p.id = #{postId}
    </select>

    <!--
      统计某叶子类目下帖子在给定时间窗内被联系次数（[153] B2-5 §9.10.2 达标判定用）。

      EXPLAIN 结论（2026-10-17 容量复核订正）：`post` 上**没有** leaf_category_id 前缀索引
      （V1–V14 从未建过 `idx_leaf_category`，原注释失实），驱动侧为全表扫 post；窗口条件写在
      `contact_event.created_at` 上（判定的是「窗口内被联系」，而非「窗口内发布的帖子」）。
      当前仅临时类目 72h 达标判定（低频运营动作）调用，内测规模可接受；post ≥ 20 万行时按
      《数据库设计文档》§6.4.1 决策建 `idx_leaf_created(leaf_category_id, created_at)`。

      只读、只出 COUNT：不 SELECT 任何密文/联系方式列。
    -->
    <select id="countContactsByLeafBetween" resultType="long">
        SELECT COUNT(*)
        FROM contact_event ce
        JOIN post p ON p.id = ce.post_id
        WHERE p.leaf_category_id = #{leafCategoryId}
          AND ce.created_at &gt;= #{from}
          AND ce.created_at &lt; #{to}
    </select>

</mapper>
