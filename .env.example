# ============================================================================
# 找鸭找（s2s）后端 · 环境变量模板（条目[121] U-5 建立）
# ----------------------------------------------------------------------------
# 用途：本机不经 compose 直跑应用时（mvn spring-boot:run / java -jar）的变量清单。
#   cp .env.example .env  →  填真实值  →  自行 source 或用 IDE 环境变量注入。
#
# 纪律（编码规范 §3.3）：
#   1. .env 权限 600、绝不入 git（.gitignore 已覆盖）；仓库只提交本模板。
#   2. 值一律为占位假值（change-me），禁止把任何真实密钥抄进本文件。
#   3. 禁 app.crypto.* 带点号键名（编码规范 §3.3）。
#   4. 变量集合与 src/main/resources/application.yml 的 ${} 占位【逐一对应】，
#      双向核对命令（集合须零差异）：
#        grep -rnohE '\$\{[A-Z_]+(:\?)?\}' src/main/resources | sort -u
#      带默认值占位（如 ${SPRING_DATA_REDIS_HOST:127.0.0.1}）不匹配该正则，
#      属非密钥本地默认值，不进本模板。
#   5. 经 compose 部署时变量由 deploy/env/.env.<env> 注入（见 deploy/env/*.example），
#      本文件不替代部署侧模板，只服务本机直跑场景。
# ============================================================================

# -- 业务库数据源（application.yml spring.datasource.*，${VAR:?} 形式）-----------
# 业务库 JDBC 连接串（KTD-7 双库之业务库；编码规范 §4.9 Flyway 迁移目标库）
# 格式：jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
# 两个参数口径（2026-09-19 实测定案，勿改回）：
#   ① sslMode=REQUIRED（不是 useSSL=false）：MySQL 8 默认认证插件 caching_sha2_password
#      在非 TLS 连接下首连须索取服务端 RSA 公钥，驱动默认禁此行为，报
#      "Public Key Retrieval is not allowed" 连不上。走 TLS 后该步不再发生；
#      刻意不用 allowPublicKeyRetrieval=true（等于把口令交给冒充 mysql 的进程）。
#   ② characterEncoding 取 Java 字符集名（UTF-8），不可写服务端字符集 utf8mb4：
#      Connector/J 按 Java charset 解析该参数，写 utf8mb4 会抛
#      "Unsupported character encoding 'utf8mb4'" 而连不上库。
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/s2s?sslMode=REQUIRED&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
# 业务库应用账号（initdb 脚本授予该账号库内权限；无 CREATE DATABASE 权限，KTD-4）
SPRING_DATASOURCE_USERNAME=change-me
# 业务库口令（六类凭证之一，编码规范 §3.3；s2s.secrets.db-password 二次引用同一变量，双保险）
SPRING_DATASOURCE_PASSWORD=change-me

# -- Redis（application.yml spring.data.redis.password，无默认值硬占位）-----------
# Redis 口令（六类凭证之一；Redis 必 requirepass，编码规范 §3.3；
# host/port 非密钥，默认值 127.0.0.1:6379 已内置 application.yml，不在本模板）
SPRING_DATA_REDIS_PASSWORD=change-me

# -- 密钥列表（application.yml s2s.secrets.*，安全 §4 key_version 列表结构）--------
# HMAC pepper 列表：盲索引 xxx_hash 的 HMAC-SHA256 密钥（禁裸 SHA-256）；
# JSON 数组，元素含 key_version 标识与密钥本体；pepper 独立介质备份，不与 DB 备份同介质
# 格式示例：[{"id":"p1","key":"<32字节随机值的十六进制或Base64>"}]
HMAC_PEPPERS_JSON=change-me
# AEAD 主密钥列表：AES-GCM-256 加解密原语密钥（随机 IV + AAD 绑定，安全 §4）
# 格式示例：[{"id":"k1","key":"<32字节随机值的十六进制或Base64>"}]
AEAD_MASTER_KEYS_JSON=change-me

# JWT HS256 签名密钥（[122] KTD10；登录态 Token 签发/验签，s2s.secrets.jwt-secret 消费）
# 强度要求：原始长度 ≥32 字节（RFC 7518 §3.2；短于 32 字节启动快速失败），
# 生成命令：openssl rand -hex 32；compose 部署时由 deploy/env/.env.<env> 注入同义变量
JWT_SECRET=change-me-jwt-secret-32-bytes-minimum

# -- OSS 凭证（六类凭证之五，媒体文件对象存储）--------------------------------------
OSS_ACCESS_KEY_ID=change-me
OSS_ACCESS_KEY_SECRET=change-me

# -- 短信与高德 Key（六类凭证之六）--------------------------------------------------
# 短信服务 Key（登录验证码渠道）
SMS_KEY=change-me
# 高德地图 Key（逆地理/POI 服务；前端高德 Key 走 --dart-define 构建期注入，与本变量不同链路）
AMAP_KEY=change-me

# ============================================================================
# compose 直注变量（不在 application.yml，故不匹配上方核对正则，单独列出以备查）
# ----------------------------------------------------------------------------
# TRACK_DATASOURCE_URL —— 埋点库 JDBC 连接串（KTD-7 双库之埋点库；架构 R14 埋点与业务分库）。
#   出处：src/main/java/com/s2s/server/config/FlywayTrackConfig.java 的
#   @Value("${TRACK_DATASOURCE_URL}") 无默认值硬注入（缺失同样启动快速失败）；
#   compose 侧由 deploy/docker-compose.yml app 服务 environment 段拼装注入。
#   本机直跑时必须手工注入，否则启动失败：
#   TRACK_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/s2s_track?sslMode=REQUIRED&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
# ============================================================================
