<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 地图与定位所需权限（高德原生 SDK）。
         注意：ACCESS_FINE_LOCATION 属运行时权限，且须在用户同意隐私协议后才可申请，
         初始化顺序见 PRD §6.7 —— 未同意不得调用 AMapInitializer.updatePrivacyAgree。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- T2 AI 智能发布 模式② 语音零键盘（B2-4）：录制一句话用于语音识别。
         运行时权限，仅在用户点「语音发布」并同意后才申请（见 audio_recorder.dart）。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 通知权限（V30 / R16）：Android 13+ 由「消息」Tab 首次进入或发布成功时运行时申请；
         低版本系统忽略该声明。缺它会导致「消息」Tab 的权限申请永远拿不到授权。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 相机（拍照发布）：走 ACTION_IMAGE_CAPTURE 委托系统相机，**不声明** android.permission.CAMERA。
         若在此声明 CAMERA 而不做运行时申请，调用系统相机会抛 SecurityException；image_picker
         的 camera source 由系统相机 app 代持权限，应用不持有该敏感权限，也无需在 Google Play
         审核里为相机用例过审。 -->

    <application
        android:label="找丫找"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowNativeHeapPointerTagging="false">
        <!-- allowNativeHeapPointerTagging="false" 为高德 SDK 必配项（PRD §6.7）：
             targetSDK ≥30 时若不声明，从地图页返回会闪退。属 🔴 上架驳回点，不得删除。 -->
        <!-- screenOrientation="portrait"（2026-10-15 真机发现）：
             本应用原先未锁竖屏，横屏下 AI 四模式弹层第 3 档被裁到只剩 12px、第 4 档完全
             不在可见区（底栏/地图/确认页等版式均按竖屏设计）。锁定竖屏是最小且彻底的修法。
             screenOrientation 与下方 configChanges 中的 orientation 不冲突：
             前者禁止旋转，后者让已发生的配置变更不重建 Activity。 -->
        <!-- launchMode="singleTask"（2026-11-13 真机发现「最近任务出现两张找丫找卡片」）：
             原为 singleTop + taskAffinity=""，任何入口只要带 FLAG_ACTIVITY_MULTIPLE_TASK
             （推送点击、桌面/系统小窗、部分 OEM 入口会带）就会再建一个以 MainActivity 为根的
             任务栈；实测 1 个任务栈 → 2 个，最近任务即出现两张卡片。singleTask 保证全局只有
             一个实例/任务栈，重复拉起只会把已有任务 bring to front（走 onNewIntent）。
             taskAffinity 同时删掉空值覆盖：singleTask 的复用匹配依赖活动亲和性，空值会让每次
             拉起都新建任务栈；缺省值即包名，与 fluwx 的 WXEntryActivity 别名保持一致。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 小米推送消息接收器（B2-2 阶段 2）。
             必须与 MiPushClient.registerPush 同进程 —— 此处不设 android:process（即主进程）；
             若改到 :pushservice 将收不到注册结果与点击回调（官方硬约束）。
             token / 点击事件经 PushMethodHandler 平台通道回传 Dart。 -->
        <receiver
            android:name=".push.MiPushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.xiaomi.mipush.RECEIVE_MESSAGE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.xiaomi.mipush.MESSAGE_ARRIVED" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.xiaomi.mipush.ERROR" />
            </intent-filter>
        </receiver>

        <!-- 华为 Push Kit（P11 华为通道客户端接入）。
             appid 由 build.gradle.kts 的 manifestPlaceholders 注入（默认 AGC 正式应用 119702145）；
             MESSAGING_EVENT 意图过滤器是收 token 与数据消息的硬要求，不可删。 -->
        <meta-data
            android:name="com.huawei.hms.client.appid"
            android:value="appid=${huaweiPushAppId}" />
        <service
            android:name=".push.HmsPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.huawei.push.action.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ 包可见性：登录页《用户协议》《隐私政策》用外部浏览器打开，
             不声明这条时 canLaunchUrl/startActivity 会被系统拦掉（点链接无反应）。 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
